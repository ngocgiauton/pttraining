# Sao chép file này thành .env.local rồi điền giá trị thật từ Supabase
# (Supabase Dashboard → Project Settings → API)

# URL của project Supabase, ví dụ: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Khóa "anon public" — dùng cho trình duyệt (an toàn vì đã bật RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Khóa "service_role" — TUYỆT MẬT, chỉ dùng phía server (tạo/khóa tài khoản).
# KHÔNG BAO GIỜ đưa khóa này vào code client hay commit lên git.
SUPABASE_SERVICE_ROLE_KEY=
